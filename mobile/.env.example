# Copy to mobile/.env.local for local development. For EAS builds, set these as EAS
# environment variables instead (see docs/SETUP.md, step 6).

# API base URL: the backend on its free serverless host (Vercel recommended).
EXPO_PUBLIC_API_URL=https://resale-hub-api.vercel.app/api

# Firebase Web API key (Firebase console > Project settings > General > Web API Key).
EXPO_PUBLIC_FIREBASE_API_KEY=

# Privacy/support pages on Firebase Hosting (Spark, free).
EXPO_PUBLIC_WEB_URL=https://resale-hub-6a648.web.app

# Optional, local dev against the emulators (`firebase emulators:start` + `cd backend && npm start`):
# EXPO_PUBLIC_API_URL=http://<your-computer-LAN-IP>:8787/api
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=<your-computer-LAN-IP>:9099
