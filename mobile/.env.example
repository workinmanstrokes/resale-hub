# Copy to mobile/.env.local for local development. For EAS builds, set these as EAS
# environment variables instead (see docs/FIREBASE_SETUP.md, step 7).

# API base URL: Firebase Hosting rewrite to the `api` Cloud Function.
EXPO_PUBLIC_API_URL=https://YOUR_PROJECT_ID.web.app/api

# Firebase Web API key (Firebase console > Project settings > General > Web API Key).
EXPO_PUBLIC_FIREBASE_API_KEY=

# Optional: where the privacy/support pages live (defaults to the API origin).
# EXPO_PUBLIC_WEB_URL=https://YOUR_PROJECT_ID.web.app

# Optional, local dev against the emulators (`firebase emulators:start`):
# EXPO_PUBLIC_API_URL=http://<your-computer-LAN-IP>:5000/api
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=<your-computer-LAN-IP>:9099
