# Resale Hub API configuration. Set these as environment variables on the API host:
#   Vercel:      Project > Settings > Environment Variables (Production)
#   Cloudflare:  `wrangler secret put NAME` (EBAY_ENV is a plain var in wrangler.toml)
#   Local:       copy to backend/.env and run `npm start`
# Never commit real values. None of these are sent to the app.

# --- Firebase (Spark plan, project resale-hub-6a648) ---
FIREBASE_PROJECT_ID=resale-hub-6a648
# Service-account key JSON from Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the whole JSON (or its base64) as one value.
FIREBASE_SERVICE_ACCOUNT=

# --- eBay (developer.ebay.com > Application Keys, Production keyset) ---
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay redirect URL name), configured with
#   Auth accepted URL: https://<your-api-host>/api/ebay/oauth/callback
#   Auth declined URL: https://<your-api-host>/api/ebay/oauth/callback
EBAY_RUNAME=
# Marketplace Account Deletion: the 32-80 character token you type in the eBay portal,
# and the exact endpoint URL you register there.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://<your-api-host>/api/ebay/account-deletion

# --- Etsy search (optional; leave empty to turn off) ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=
