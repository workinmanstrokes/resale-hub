# Copy this file to .env and fill in what you have. Everything is optional —
# the server runs and degrades gracefully with any subset configured.

# --- Auth (required for login/register to be meaningful) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- eBay (free developer account: https://developer.ebay.com) ---
# Create a keyset under "Application Keys". Use sandbox keys while testing.
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Register this exact URL as your eBay app's "Your auth accepted URL" (RuName setup),
# or use the RuName eBay gives you directly here instead of a raw URL.
EBAY_REDIRECT_URI=http://localhost:4000/api/ebay/oauth/callback

# --- Etsy (free developer account: https://www.etsy.com/developers) ---
ETSY_API_KEY=

PORT=4000
