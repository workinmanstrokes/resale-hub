{
  "name": "resale-hub-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Resale Hub API (Firebase Cloud Functions, Node 22)",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth,storage,hosting",
    "deploy": "firebase deploy --only functions,firestore,storage,hosting",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore,auth,storage --project demo-resale-hub \"node --test test/api.test.js\""
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  }
}
